LINE    PG/LN  A...B............................................................

000053         01  WS-END-OF-PRINTER-LIST          PIC X VALUE "N".
000054             88  END-OF-PRINTER-LIST         VALUE "Y".
000055             88  MORE-PRINTERS               VALUE "N".
000056
000057         01  WS-SELECTED-PRINTER             PIC X(128)
000058                                                     VALUE SPACES.
000059
000060         01  WS-PRINT-COMMAND                PIC X(500)
000061                                                     VALUE SPACES.
000062
000063         01  WS-QUERY-COMMAND                PIC X(200)
000064             VALUE
000065             "lpstat -a | awk '{print $1}' > cups-printers.tmp".
000066
000067         01  WS-FORM-FEED-COMMAND            PIC X(200)
000068             VALUE
000069             "printf '\014' >> print-80-records.txt".
000070
000071         01  WS-DELETE-TEMP-COMMAND          PIC X(100)
000072             VALUE "rm -f cups-printers.tmp print-80-records.txt".
000073
000074         01  WS-PRINTER-TABLE.
000075             05  WS-PRINTER-ENTRY OCCURS 20 TIMES.
000076                 10  WS-PRINTER-NAME         PIC X(128).
000077
000078         PROCEDURE DIVISION.
000079
000080         100-MAIN.
000081
000082             PERFORM 120-QUERY-PRINTERS
000083
000084             PERFORM 150-SELECT-PRINTER
000085
000086             PERFORM 200-OPEN-NEW-REPORT
000087
000088             PERFORM 300-START-NEW-PAGE
000089
000090             PERFORM VARYING WS-RECORD-NUMBER
000091                 FROM 1 BY 1
000092                 UNTIL WS-RECORD-NUMBER > 80
000093
000094                 IF WS-LINE-COUNT >= WS-MAX-LINES
000095                     PERFORM 500-INSERT-FORM-FEED
000096                     PERFORM 300-START-NEW-PAGE
000097                 END-IF
000098
000099                 PERFORM 400-WRITE-DETAIL-RECORD
000100             END-PERFORM
000101
000102             PERFORM 600-CLOSE-REPORT
000103
000104             PERFORM 700-SEND-TO-PRINTER
