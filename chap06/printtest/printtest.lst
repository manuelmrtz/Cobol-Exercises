000001         IDENTIFICATION DIVISION.
000002         PROGRAM-ID. PRINT80.
000003        ******************************************************************
000004        * PURPOSE: CREATE AN 80-RECORD REPORT, QUERY AVAILABLE CUPS      *
000005        *          PRINTERS, LET THE USER SELECT ONE, AND PRINT.         *
000006        ******************************************************************
000007
000008         ENVIRONMENT DIVISION.
000009         INPUT-OUTPUT SECTION.
000010         FILE-CONTROL.
000011
000012             SELECT PRINT-FILE
000013                 ASSIGN TO "print-80-records.txt"
000014                 ORGANIZATION IS LINE SEQUENTIAL
000015                 FILE STATUS IS WS-PRINT-STATUS.
000016
000017             SELECT PRINTER-LIST-FILE
000018                 ASSIGN TO "cups-printers.tmp"
000019                 ORGANIZATION IS LINE SEQUENTIAL
000020                 FILE STATUS IS WS-LIST-STATUS.
000021
000022         DATA DIVISION.
000023         FILE SECTION.
000024
000025         FD  PRINT-FILE.
000026         01  PRINT-RECORD                    PIC X(80).
000027
000028         FD  PRINTER-LIST-FILE.
000029         01  PRINTER-LIST-RECORD             PIC X(128).
000030
000031         WORKING-STORAGE SECTION.
000032
000033         01  WS-PRINT-STATUS                 PIC XX VALUE SPACES.
000034         01  WS-LIST-STATUS                  PIC XX VALUE SPACES.
000035
000036         01  WS-RETURN-CODE                  PIC S9(9) COMP-5
000037                                                     VALUE ZERO.
000038
000039         01  WS-RECORD-NUMBER                PIC 99 VALUE ZERO.
000040         01  WS-DISPLAY-NUMBER               PIC Z9.
000041
000042         01  WS-PAGE-NUMBER                  PIC 99 VALUE ZERO.
000043         01  WS-DISPLAY-PAGE                 PIC Z9.
000044
000045         01  WS-LINE-COUNT                   PIC 99 VALUE ZERO.
000046         01  WS-MAX-LINES                    PIC 99 VALUE 60.
000047
000048         01  WS-PRINTER-COUNT                PIC 99 VALUE ZERO.
000049         01  WS-PRINTER-INDEX                PIC 99 VALUE ZERO.
000050         01  WS-PRINTER-SELECTION            PIC 99 VALUE ZERO.
000051         01  WS-MENU-NUMBER                  PIC Z9.
000052
