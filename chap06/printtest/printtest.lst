000107
000108             STOP RUN.
000109
000110         120-QUERY-PRINTERS.
000111
000112             CALL "SYSTEM"
000113                 USING WS-QUERY-COMMAND
000114                 RETURNING WS-RETURN-CODE
000115             END-CALL
000116
000117             IF WS-RETURN-CODE NOT = ZERO
000118                 DISPLAY "ERROR QUERYING CUPS PRINTERS"
000119                 DISPLAY "RETURN CODE: " WS-RETURN-CODE
000120                 STOP RUN
000121             END-IF
000122
000123             OPEN INPUT PRINTER-LIST-FILE
000124
000125             IF WS-LIST-STATUS NOT = "00"
000126                 DISPLAY "ERROR OPENING PRINTER LIST"
000127                 DISPLAY "FILE STATUS: " WS-LIST-STATUS
000128                 STOP RUN
000129             END-IF
000130
000131             MOVE ZERO TO WS-PRINTER-COUNT
000132             SET MORE-PRINTERS TO TRUE
000133
000134             PERFORM UNTIL END-OF-PRINTER-LIST
000135                 READ PRINTER-LIST-FILE
000136                     AT END
000137                         SET END-OF-PRINTER-LIST TO TRUE
000138
000139                     NOT AT END
000140                         IF PRINTER-LIST-RECORD NOT = SPACES
000141                             IF WS-PRINTER-COUNT < 20
000142                                 ADD 1 TO WS-PRINTER-COUNT
000143
000144                                 MOVE PRINTER-LIST-RECORD
000145                                     TO WS-PRINTER-NAME
000146                                        (WS-PRINTER-COUNT)
000147                             END-IF
000148                         END-IF
000149                 END-READ
000150             END-PERFORM
000151
000152             CLOSE PRINTER-LIST-FILE
000153
000154             IF WS-LIST-STATUS NOT = "00"
000155                 DISPLAY "ERROR CLOSING PRINTER LIST"
000156                 DISPLAY "FILE STATUS: " WS-LIST-STATUS
GnuCOBOL 3.2.0          printtest.cbl        Sat Jul 25 2026 22:58:49  Page 0004

LINE    PG/LN  A...B............................................................

000157                 STOP RUN
000158             END-IF
000159
000160             IF WS-PRINTER-COUNT = ZERO
000161                 DISPLAY "NO CUPS PRINTERS ARE AVAILABLE"
000162                 DISPLAY "CHECK WITH: lpstat -a"
000163                 STOP RUN
000164             END-IF.
000165
000166         150-SELECT-PRINTER.
000167
000168             DISPLAY SPACE
000169             DISPLAY "AVAILABLE CUPS PRINTERS"
000170             DISPLAY "-----------------------"
000171
000172             PERFORM VARYING WS-PRINTER-INDEX
000173                 FROM 1 BY 1
000174                 UNTIL WS-PRINTER-INDEX > WS-PRINTER-COUNT
000175
000176                 MOVE WS-PRINTER-INDEX TO WS-MENU-NUMBER
000177
000178                 DISPLAY WS-MENU-NUMBER
000179                     " - "
000180                     FUNCTION TRIM
000181                         (WS-PRINTER-NAME(WS-PRINTER-INDEX))
000182             END-PERFORM
000183
000184             DISPLAY SPACE
000185             DISPLAY "ENTER PRINTER NUMBER: "
000186                 WITH NO ADVANCING
000187
000188             ACCEPT WS-PRINTER-SELECTION
000189
000190             IF WS-PRINTER-SELECTION < 1
000191                 DISPLAY "INVALID SELECTION"
000192                 PERFORM 150-SELECT-PRINTER
000193             ELSE
000194                 IF WS-PRINTER-SELECTION > WS-PRINTER-COUNT
000195                     DISPLAY "INVALID SELECTION"
000196                     PERFORM 150-SELECT-PRINTER
000197                 ELSE
000198                     MOVE WS-PRINTER-NAME
000199                         (WS-PRINTER-SELECTION)
000200                         TO WS-SELECTED-PRINTER
000201                 END-IF
000202             END-IF
000203
000204             PERFORM 170-BUILD-PRINT-COMMAND.
000205
